meta {
  name: Get token, exchange the authorization code
  type: http
  seq: 1
}

post {
  url: https://{{epic_oauth_host}}/account/api/oauth/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{epic_client_id}}
  password: {{epic_client_secret}}
}

headers {
  User-Agent: {{epic_user_agent}}
}

body:form-urlencoded {
  grant_type: authorization_code
  code: {{process.env.EPIC_CODE}}
  token_type: eg1
}

docs {
  Returns access_token, expires_at, refresh_token, refresh_expires_at, account_id and
  displayName. The code is single use and expires fast.
}
