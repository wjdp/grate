meta {
  name: Refresh token
  type: http
  seq: 2
}

post {
  url: https://{{epic_oauth_host}}/account/api/oauth/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{epic_client_id}}
  password: {{epic_client_secret}}
}

headers {
  User-Agent: {{epic_user_agent}}
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{process.env.EPIC_REFRESH_TOKEN}}
  token_type: eg1
}
