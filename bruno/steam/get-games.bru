meta {
  name: Get Games
  type: http
  seq: 4
}

get {
  url: https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key={{process.env.STEAM_API_KEY}}&steamid={{process.env.STEAM_USER_ID}}&include_appinfo=1&include_played_free_games=1&include_extended_appinfo=1
  body: none
  auth: none
}

params:query {
  key: {{process.env.STEAM_API_KEY}}
  steamid: {{process.env.STEAM_USER_ID}}
  include_appinfo: 1
  include_played_free_games: 1
  include_extended_appinfo: 1
}
