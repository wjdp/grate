meta {
  name: Get user info
  type: http
  seq: 3
}

get {
  url: https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/?key={{process.env.STEAM_API_KEY}}&steamids={{process.env.STEAM_USER_ID}}
  body: none
  auth: none
}

params:query {
  key: {{process.env.STEAM_API_KEY}}
  steamids: {{process.env.STEAM_USER_ID}}
}
